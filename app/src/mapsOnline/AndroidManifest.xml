<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The mapsOnline flavor, and ONLY this flavor, is granted INTERNET — purely so the
         map screen can fetch OpenStreetMap raster/vector tiles. It is never the default
         build. The offline flavor has no INTERNET permission at all. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
