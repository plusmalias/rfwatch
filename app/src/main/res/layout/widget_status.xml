<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#E6070B10">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RF//WATCH"
        android:textColor="#4DE2C5"
        android:textSize="12sp"
        android:letterSpacing="0.1" />
    <TextView
        android:id="@+id/widget_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Not monitoring"
        android:textColor="#E4EDF2"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_lines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap to open"
        android:textColor="#91A4B0"
        android:textSize="12sp" />
</LinearLayout>
